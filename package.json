{
  "name": "clanker-media-downloader",
  "version": "1.0.0",
  "private": true,
  "description": "One-click image downloads from image hosting sites — MV3 browser extension",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "build:firefox": "BROWSER=firefox vp build",
    "dev": "vp build --watch",
    "check": "vp check && tsc --noEmit",
    "lint": "vp lint src/",
    "fmt": "vp fmt src/",
    "test": "bun test"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/chrome": "^0.3.4",
    "@types/webextension-polyfill": "^0.12.6",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-web-extension": "^4.5.1",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "trustedDependencies": [
    "spawn-sync"
  ]
}
